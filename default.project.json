{
  "name": "1000 Hidden Objects",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "ServerStorage": {
      "$ignoreUnknownInstances": true,
      "Rooms": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      },
      "Targets": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      },
      "ClutterAssets": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      }
    },

    "StarterPlayer": {
      "$properties": {
        "CharacterWalkSpeed": 16,
        "EnableMouseLockOption": true
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Players": {
      "$properties": {
        "CharacterAutoLoads": true,
        "RespawnTime": 2
      }
    },

    "Workspace": {
      "$ignoreUnknownInstances": true,
      "$properties": {
        "FilteringEnabled": true,
        "PhysicsSteppingMethod": "Adaptive"
      }
    },

    "Lighting": {
      "$properties": {
        "Ambient": [0.35, 0.35, 0.4],
        "OutdoorAmbient": [0.5, 0.5, 0.55],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "ShadowMap",
        "ClockTime": 14
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}

